[Unit]
Description=SYNERGY MVP Node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/synergy-ai-blockchain
Environment=PYTHONPATH=/opt/synergy-ai-blockchain
ExecStart=/opt/synergy-ai-blockchain/.venv/bin/python scripts/mvp_node.py --role %i
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/synergy

[Install]
WantedBy=multi-user.target
