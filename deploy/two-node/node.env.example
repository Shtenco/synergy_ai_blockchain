# Скопировать в node.env на КАЖДОМ узле и заполнить. Не коммитить заполненный файл.
# Узел 1 и узел 2 отличаются NODE_ID / MESH_PORT / GOSSIP_PORT.

# Идентичность (PQ): пути к существующим ключам узла (ML-DSA-87 + SLH-DSA).
NODE_ID=DESKTOP-NODE-1
ML_DSA_PUBKEY_HEX=
SLH_DSA_PUBKEY_HEX=

# Сеть mesh (должна совпадать на обоих узлах).
NETWORK_ID_HEX=
EPOCH=1

# Локальные порты.
MESH_TCP_PORT=41001
MESH_UDP_PORT=41002
GOSSIP_PORT=41003

# Пир: адрес ДРУГОГО узла (node1 -> node2 и наоборот).
PEER_ADDR=
PEER_MESH_TCP_PORT=41001
PEER_ML_KEM_PUBKEY_HEX=

# Политика транспорта: только PqOnly.
TRANSPORT_POLICY=PqOnly

# TUN: имя интерфейса и exit-нода (yes/no).
TUN_IF=synergy0
TUN_EXIT_NODE=no
