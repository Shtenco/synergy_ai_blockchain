{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sinergy.system/schemas/commitment.envelope/v1",
  "title": "SINERGY CommitmentEnvelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "domain",
    "network_domain",
    "verifier_id",
    "payload_schema",
    "subject_id",
    "sequence",
    "as_of",
    "payload_digest",
    "signer_policy"
  ],
  "properties": {
    "schema_version": {"const": "commitment.envelope/v1"},
    "domain": {"type": "string", "pattern": "^SINERGY:"},
    "network_domain": {"type": "string", "minLength": 1},
    "verifier_id": {"type": "string", "minLength": 1},
    "payload_schema": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 0},
    "as_of": {"type": "string", "format": "date-time"},
    "payload_digest": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "previous_commitment": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$"},
    "signer_policy": {"type": "string", "minLength": 1},
    "metadata_digest": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$"}
  }
}
